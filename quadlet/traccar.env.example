# Instalar como ~/.config/containers/systemd/traccar.env con permisos 0600.
# La base de datos debe ejecutarse en el mismo pod y escuchar en 5432.
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/traccar
DATABASE_USER=traccar
DATABASE_PASSWORD=REPLACE_WITH_A_SECRET

WEB_ADDRESS=0.0.0.0
WEB_PORT=8082

# Mantén estos valores alineados con los defaults versionados en traccar.xml.
# Sirven como overrides explícitos para este despliegue Quadlet.
DATABASE_MAX_POOL_SIZE=30
SERVER_TIMEOUT=60
DATABASE_REGISTER_UNKNOWN=false
