# =============================================================================
# TRACCAR SERVICE ENVIRONMENT (template)
# =============================================================================
# Copy to traccar/.env before running `docker compose up`.
# Consumido por el servicio `traccar` (env_file) como propiedades de Traccar.
# La base de datos en sí (su creación y sus credenciales) vive en
# traccar-db/.env; DATABASE_USER / DATABASE_PASSWORD aquí deben coincidir con
# POSTGRES_USER / POSTGRES_PASSWORD de ese archivo.

# --- conexión a la base de datos de Traccar ---
DATABASE_DRIVER=org.postgresql.Driver
# Dirección interna: traccar-db escucha en 5432 en la red de compose.
# TRACCAR_DB_PORT en el .env raíz es el puerto publicado en el host, no este.
# Para apuntar a una base externa, edita esta línea (y comenta el servicio
# traccar-db en compose.yml).
DATABASE_URL=jdbc:postgresql://traccar-db:5432/traccar
DATABASE_USER=traccar
DATABASE_PASSWORD=traccar

WEB_ADDRESS=0.0.0.0
WEB_PORT=8082
