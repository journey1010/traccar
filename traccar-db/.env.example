# =============================================================================
# TRACCAR DATABASE (TimescaleDB) ENVIRONMENT (template)
# =============================================================================
# Copy to traccar-db/.env before the first `docker compose up`.
# Consumido por el servicio traccar-db de compose.yml (env_file).
# Si cambias las credenciales aquí, cambia a los mismos valores
# DATABASE_USER / DATABASE_PASSWORD en traccar/.env: ahí lee su conexión el
# servidor Traccar.

# Base de datos que el entrypoint de postgres crea en el primer arranque.
POSTGRES_DB=traccar
POSTGRES_USER=traccar
POSTGRES_PASSWORD=traccar

# La imagen de timescaledb pide permiso para enviar telemetría anónima.
TIMESCALEDB_TELEMETRY=off

# Política de historial (ver apply-policies.sh). Días; 0 desactiva.
# La compresión debe ser menor que la retención.
TRACCAR_RETENTION_DAYS=90
TRACCAR_COMPRESSION_DAYS=14
